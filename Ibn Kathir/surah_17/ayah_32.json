{
  "surah": 17,
  "ayah": 32,
  "tafsir_id": 7,
  "blocks": [
    {
      "type": "tafsir",
      "text": "يقول تعالى ناهياً عباده عن الزنى وعن مقاربته ومخالطة أسبابه ودواعيه: { وَلاَ تَقْرَبُواْ ٱلزِّنَىٰ إِنَّهُ كَانَ فَاحِشَةً } أي: ذنباً عظيماً { وَسَآءَ سَبِيلاً } أي: بئس طريقاً ومسلكاً. وقد قال الإمام أحمد: حدثنا يزيد بن هارون، حدثنا سليم بن عامر عن أبي أمامة أن فتى شاباً أتى النبي صلى الله عليه وسلم فقال: يا رسول الله ائذن لي بالزنى، فأقبل القوم عليه فزجروه، وقالوا: مه مه، فقال:",
      "id": "17_32_tafsir_b1"
    },
    {
      "type": "hadeeth",
      "text": "\"ادنه\"",
      "id": "17_32_hadeeth_b2"
    },
    {
      "type": "tafsir",
      "text": "فدنا منه قريباً، فقال:",
      "id": "17_32_tafsir_b3"
    },
    {
      "type": "hadeeth",
      "text": "\"اجلس\"",
      "id": "17_32_hadeeth_b4"
    },
    {
      "type": "tafsir",
      "text": "فجلس، فقال:",
      "id": "17_32_tafsir_b5"
    },
    {
      "type": "hadeeth",
      "text": "\"أتحبه لأمك\"",
      "id": "17_32_hadeeth_b6"
    },
    {
      "type": "tafsir",
      "text": "؟ قال: لا والله، جعلني الله فداك، قال:",
      "id": "17_32_tafsir_b7"
    },
    {
      "type": "hadeeth",
      "text": "\"ولا الناس يحبونه لأمهاتهم\"",
      "id": "17_32_hadeeth_b8"
    },
    {
      "type": "tafsir",
      "text": "، قال:",
      "id": "17_32_tafsir_b9"
    },
    {
      "type": "hadeeth",
      "text": "\"أفتحبه لابنتك؟\"",
      "id": "17_32_hadeeth_b10"
    },
    {
      "type": "tafsir",
      "text": "قال: لا والله يا رسول الله جعلني الله فداك، قال:",
      "id": "17_32_tafsir_b11"
    },
    {
      "type": "hadeeth",
      "text": "\"ولا الناس يحبونه لبناتهم\"",
      "id": "17_32_hadeeth_b12"
    },
    {
      "type": "tafsir",
      "text": ". قال:",
      "id": "17_32_tafsir_b13"
    },
    {
      "type": "hadeeth",
      "text": "\"أفتحبه لأختك؟\"",
      "id": "17_32_hadeeth_b14"
    },
    {
      "type": "tafsir",
      "text": "قال: لا والله، جعلني الله فداك، قال:",
      "id": "17_32_tafsir_b15"
    },
    {
      "type": "hadeeth",
      "text": "\"ولا الناس يحبونه لأخواتهم\"",
      "id": "17_32_hadeeth_b16"
    },
    {
      "type": "tafsir",
      "text": "، قال:",
      "id": "17_32_tafsir_b17"
    },
    {
      "type": "hadeeth",
      "text": "\"أفتحبه لعمتك؟\"",
      "id": "17_32_hadeeth_b18"
    },
    {
      "type": "tafsir",
      "text": "قال: لا والله يا رسول الله، جعلني الله فداك، قال:",
      "id": "17_32_tafsir_b19"
    },
    {
      "type": "hadeeth",
      "text": "\"ولا الناس يحبونه لعماتهم\"",
      "id": "17_32_hadeeth_b20"
    },
    {
      "type": "tafsir",
      "text": "، قال:",
      "id": "17_32_tafsir_b21"
    },
    {
      "type": "hadeeth",
      "text": "\"أفتحبه لخالتك؟\"",
      "id": "17_32_hadeeth_b22"
    },
    {
      "type": "tafsir",
      "text": "قال: لا والله يا رسول الله، جعلني الله فداك، قال:",
      "id": "17_32_tafsir_b23"
    },
    {
      "type": "hadeeth",
      "text": "\"ولا الناس يحبونه لخالاتهم\"",
      "id": "17_32_hadeeth_b24"
    },
    {
      "type": "tafsir",
      "text": "قال: فوضع يده عليه، وقال",
      "id": "17_32_tafsir_b25"
    },
    {
      "type": "hadeeth",
      "text": "\"اللهم اغفر ذنبه، وطهر قلبه، وأحصن فرجه\"",
      "id": "17_32_hadeeth_b26"
    },
    {
      "type": "tafsir",
      "text": "قال: فلم يكن بعد ذلك الفتى يلتفت إلى شيء، وقال ابن أبي الدنيا: حدثنا عمار بن نصر، حدثنا بقية عن أبي بكر بن أبي مريم عن الهيثم بن مالك الطائي، عن النبي صلى الله عليه وسلم قال:",
      "id": "17_32_tafsir_b27"
    },
    {
      "type": "hadeeth",
      "text": "\"ما من ذنب بعد الشرك أعظم عند الله من نطفة وضعها رجل في رحم لا يحل له\"",
      "id": "17_32_hadeeth_b28"
    }
  ]
}